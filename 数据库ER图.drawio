        <mxCell id="e_scores_sections" value="1:N score_id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;fontSize=10;strokeColor=#1f4e79;" edge="1" parent="1" source="scores" target="sections">
          <mxGeometry relative="1" as="geometry" />
