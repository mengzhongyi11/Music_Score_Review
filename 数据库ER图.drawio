          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_br_mc" value="1:N branch_id" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=classic;fontSize=10;strokeColor=#d79b00;" edge="1" parent="1" source="branches" target="merge_conflicts">
